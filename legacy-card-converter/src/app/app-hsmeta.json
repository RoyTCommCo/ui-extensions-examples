{
  "uid": "legacy-card-converter-app",
  "type": "app",
  "config": {
    "description": "A tool to convert legacy cards to UI Extensions while designing a new card.",
    "name": "Legacy Card Converter App",
    "distribution": "private",
    "auth": {
      "type": "static",
      "requiredScopes": [
        "oauth",
        "crm.objects.contacts.read",
        "crm.objects.contacts.write",
        "crm.objects.deals.read",
        "crm.objects.deals.write",
        "crm.objects.tickets.read",
        "crm.objects.tickets.write"
      ],
      "optionalScopes": [],
      "conditionallyRequiredScopes": []
    },
    "permittedUrls": {
      "fetch": [
        "https://visibility.bi.community.co/hubspot/card/webhook/data-fetch",
        "https://visibility.bi.community.co"
      ],
      "iframe": [
        "https://visibility.bi.community.co"
      ],
      "img": []
    },
    "support": {
      "supportEmail": "support@example.com",
      "documentationUrl": "https://example.com/docs",
      "supportUrl": "https://example.com/support",
      "supportPhone": "+18005555555"
    }
  }
}